{
  "action": {
    "default_icon": {
      "16": "icons/BbOrangeGradient16.png",
      "48": "icons/BbOrangeGradient48.png",
      "128": "icons/BbOrangeGradient128.png"
    },
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "options/background.js"
  },
  "content_scripts": [
    {
      "js": [
        "content/content.js"
      ],
      "matches": [
        "https://vle.iau.edu.sa/*",
        "https://*.blackboard.com/*"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "description": "Local repair of Better Blackboard Learn: dark mode and custom themes for IAU Blackboard.",
  "icons": {
    "16": "icons/BbOrangeGradient16.png",
    "48": "icons/BbOrangeGradient48.png",
    "128": "icons/BbOrangeGradient128.png"
  },
  "manifest_version": 3,
  "name": "Better Blackboard Learn (Fixed)",
  "options_page": "options/options.html",
  "permissions": [
    "storage"
  ],
  "version": "1.2.13"
}
